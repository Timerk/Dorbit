; Open this file with Godot 4.7.2 or later in the 4.7 series.
config_version=5

[application]
config/name="Dorbit"
run/main_scene="res://scenes/sector.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A first playable space encounter."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.028, 1)

[physics]
common/physics_ticks_per_second=60

[input_devices]
pointing/emulate_touch_from_mouse=false
