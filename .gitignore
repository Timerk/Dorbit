.godot/
.tools/
build/*
!build/.gdignore
*.log
export_credentials.cfg
__pycache__/

# Intermediate review renders are assembled into the tracked view sheets.
/art/ship-review/previews/*.png
/art/ship-review/materials/*/perspective.png
/art/ship-review/materials/*/front.png
/art/ship-review/materials/*/rear.png
/art/ship-review/materials/*/side.png
/art/ship-review/materials/*/top.png
/art/ship-review/materials/*/underside.png
/art/station-review/*.blend1

# External Bigpoint imagery must remain outside the public repository.
/art/ship-review/references/*
!/art/ship-review/references/sources.json
/art/ship-review/previews/*-comparison.jpg
/art/ship-review/previews/additional-ships-overview.jpg
/art/ship-review/concepts/catalogue-roster-reference.jpg
/art/ship-review/models/*.blend1

.ci/
